APP_NAME=SXUWhatEat
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://sxuwhateat:your_mysql_password@127.0.0.1:3306/sxuwhateat?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# VPN 内网使用 HTTP 时设为 false；公网 HTTPS 部署应保持 true。
AUTH_COOKIE_SECURE=true
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@qq.com
SMTP_PASS=your_16_character_authorization_code
MAIL_FROM=your_email@qq.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
